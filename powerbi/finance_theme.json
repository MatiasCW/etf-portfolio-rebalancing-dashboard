{
  "name": "Finance Dashboard Theme - High Contrast",
  "dataColors": [
    "#00C2FF",
    "#00E676",
    "#FF5252",
    "#FFD700",
    "#7C4DFF",
    "#FF9100",
    "#40C4FF",
    "#B0BEC5"
  ],
  "background": "#0B1020",
  "foreground": "#FFFFFF",
  "tableAccent": "#00C2FF",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#111827"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#00C2FF"
              }
            },
            "radius": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#374151"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#00C2FF"
              }
            },
            "radius": 12
          }
        ],
        "labels": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 30,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "fontColor": {
              "solid": {
                "color": "#93C5FD"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI"
          }
        ],
        "calloutValue": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 30
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E3A8A"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "backColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "grid": [
          {
            "outlineColor": {
              "solid": {
                "color": "#243B55"
              }
            },
            "gridVertical": false,
            "gridHorizontal": true
          }
        ]
      }
    }
  }
}